# Database dumps written by src/seed/dbExport.js. Never committed: they are a
# full copy of the live database — every staff email, phone number and record
# in it — and they are large enough (13MB a run) to bloat the history for
# nothing. Keep them on disk or in a private store, not in git.
backup/
*.dump/
