# Copy this to .env for local development (.env is gitignored, so your copy
# stays local). Production instead reads .env.production automatically when
# running `vite build` — see that file, not this one, for the deployed value.

# Base URL of the backend API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── Franchise Network Map (optional) ────────────────────────────────────
# Google Photorealistic 3D Tiles key.
#
# LEAVE THIS UNSET. The map runs entirely on free, keyless sources — Esri World
# Imagery, OpenFreeMap vector tiles, OSM building extrusions and AWS Terrain —
# and needs no account to render real satellite, real streets, real buildings
# and real terrain.
#
# This exists as the seam for a later upgrade to Google's photorealistic mesh.
# Setting it alone does NOT switch anything on: those are OGC 3D Tiles, which
# MapLibre cannot render natively, so the swap also needs CesiumJS or deck.gl's
# Tile3DLayer. See features/network/mapStyles.js#photorealAvailable.
# VITE_GOOGLE_3D_TILES_KEY=


# -- Public apply link --------------------------------------------------
# The origin used to build the shareable /apply/<id> link that HR sends to
# candidates on WhatsApp.
#
# Leave it UNSET on the deployed site: the link then uses the origin the
# page is already served from, which is correct there and stays correct if
# the site later moves to a custom domain.
#
# SET it for local development. Otherwise the copied link reads
# http://localhost:5173/apply/... and reaches nobody outside your machine.
#
# No trailing slash needed; one is stripped if present.
VITE_PUBLIC_SITE_URL=https://erpmystery.netlify.app
