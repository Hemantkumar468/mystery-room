# Loaded by `vite build` (production mode).
#
# PREFER setting VITE_API_BASE_URL in the Netlify UI (Site settings →
# Environment variables) rather than committing it here. Vite gives an
# environment variable that already exists at build time priority over this
# file, so the Netlify value wins — and production, deploy previews and
# branch deploys can each point somewhere different without a commit.
#
# This file is the fallback for anyone running `npm run build` locally.
#
# MUST end with the API prefix. The client appends paths like "/auth/login"
# to this value, so a base URL missing "/api/v1" produces requests to routes
# that do not exist, and a trailing slash produces a double slash.
#
#   Right:  https://mysteryrooms-api.onrender.com/api/v1
#   Wrong:  https://mysteryrooms-api.onrender.com          ← no prefix
#   Wrong:  https://mysteryrooms-api.onrender.com/api/v1/  ← trailing slash
#   Wrong:  https://mysteryrooms-api.onrender.com/api/v1/auth
#
# Leave it EMPTY to fall back to the relative "/api/v1" — the right choice
# only if you are using netlify.toml's same-origin proxy redirect instead.
VITE_API_BASE_URL=


# -- Public apply link --------------------------------------------------
# Intentionally left unset. The shareable /apply/<id> link then falls back
# to the origin the page is served from, so production, deploy previews and
# a future custom domain each produce a link that actually points at
# themselves. Hardcoding the Netlify URL here would keep sending candidates
# to netlify.app the day the site moves to a Mystery Rooms domain.
#
# Override it in the Netlify UI only if the apply link must point somewhere
# other than the site serving it.
VITE_PUBLIC_SITE_URL=
