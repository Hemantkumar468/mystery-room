# ---- Server ----
PORT=5055

# ---- WhatsApp Cloud API (Meta) ----
# 15-digit Phone Number ID from Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Permanent / temporary access token (System User token recommended)
WHATSAPP_ACCESS_TOKEN=EAAG...replace_me

# Optional: WhatsApp Business Account ID (only needed for GET /templates)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Provider: meta | smartwhap. Leave blank to auto-detect from the token
# (wm_... = smartwhap, EAA... = meta).
WHATSAPP_PROVIDER=

# Override the API host. Leave BLANK to use the provider's default
# (meta -> https://graph.facebook.com, smartwhap -> https://app.smartwhap.com/api/v2)
WHATSAPP_BASE_URL=

# Graph API version
GRAPH_API_VERSION=v21.0

# Default country code used when a 10-digit local number is passed (91 = India)
DEFAULT_COUNTRY_CODE=91

# Optional: simple shared secret. If set, every request must send header
#   x-api-key: <this value>
API_KEY=
