{
  "info": {
    "name": "WhatsApp Check",
    "description": "Test WhatsApp API credentials (SmartWhap or Meta) by sending real messages. Credentials are read from the service .env; override per request with accessToken/provider in the body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5055"
    },
    {
      "key": "phone",
      "value": "9876543210"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "health"
          ]
        }
      }
    },
    {
      "name": "Verify credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "verify"
          ]
        }
      }
    },
    {
      "name": "Send text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"message\": \"Hello from WhatsApp Check\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/text",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "text"
          ]
        }
      }
    },
    {
      "name": "Send template (approved on this account)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"templateName\": \"crcampaign\",\n  \"languageCode\": \"en_US\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/template",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "template"
          ]
        }
      }
    },
    {
      "name": "Send image",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"link\": \"https://www.w3.org/Graphics/PNG/nurbcup2si.png\",\n  \"caption\": \"Image test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/image",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "image"
          ]
        }
      }
    },
    {
      "name": "Send document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"link\": \"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\",\n  \"filename\": \"Sample.pdf\",\n  \"caption\": \"Document test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/document",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "document"
          ]
        }
      }
    },
    {
      "name": "Send location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"latitude\": 28.6139,\n  \"longitude\": 77.209,\n  \"name\": \"Mystery Rooms\",\n  \"address\": \"Connaught Place, New Delhi\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/location",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "location"
          ]
        }
      }
    },
    {
      "name": "Send buttons",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"message\": \"Confirm your booking?\",\n  \"buttons\": [\"Yes\", \"No\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/buttons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "buttons"
          ]
        }
      }
    },
    {
      "name": "Send list",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"message\": \"Pick a slot\",\n  \"buttonText\": \"View slots\",\n  \"sections\": [\n    { \"title\": \"Saturday\", \"rows\": [ { \"id\": \"s1\", \"title\": \"11:00 AM\" }, { \"id\": \"s2\", \"title\": \"1:00 PM\" } ] }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/list",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "list"
          ]
        }
      }
    },
    {
      "name": "Send CTA link button (SmartWhap)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"message\": \"Your booking is confirmed\",\n  \"buttonText\": \"View booking\",\n  \"buttonUrl\": \"https://mysteryrooms.in/\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/cta",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "cta"
          ]
        }
      }
    },
    {
      "name": "Send bulk",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phones\": [\"{{phone}}\"],\n  \"message\": \"Broadcast test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/bulk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "bulk"
          ]
        }
      }
    },
    {
      "name": "Send raw payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"messaging_product\": \"whatsapp\",\n    \"to\": \"91{{phone}}\",\n    \"type\": \"text\",\n    \"text\": { \"body\": \"Raw payload test\" }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/send/raw",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "send",
            "raw"
          ]
        }
      }
    },
    {
      "name": "List templates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/whatsapp/templates",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "whatsapp",
            "templates"
          ]
        }
      }
    }
  ]
}