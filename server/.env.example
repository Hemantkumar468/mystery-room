# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mysteryrooms_erp

# ── Auth ────────────────────────────────────────────────
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGINS=http://localhost:5173

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ── Delegation & Checklist modules (all optional) ───────
# Business timezone: decides what "today", "overdue" and "this week" mean,
# independent of where the server is hosted.
OPS_TIMEZONE=Asia/Kolkata
# Scheduled jobs: recurring tasks, reminders, escalations, digests.
JOBS_ENABLED=true
# Evidence / proof / reference uploads (stored on local disk)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=15
# Used for links inside notification emails
APP_URL=http://localhost:5173
# Email is sent only when SMTP_HOST is set; in-app notifications always work.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Mystery Rooms ERP <no-reply@mysteryrooms.in>
