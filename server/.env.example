# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mysteryrooms_erp

# ── Auth ────────────────────────────────────────────────
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGINS=http://localhost:5173

# ── Cloudinary (file/image uploads) ─────────────────────
# From your Cloudinary dashboard (https://cloudinary.com/console).
# All three are required to enable uploads; leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI module (property / location intelligence) ────────
# Set at least one provider key to switch the module on. With none set the
# endpoints answer 503 and the UI shows a "not configured" state — the server
# still boots normally.
#
#   auto   → prefer Gemini (first-party Google Search grounding), else OpenAI
#   openai → OpenAI Responses API + web_search tool
#   gemini → Gemini generateContent + google_search grounding
AI_ENABLED=true
AI_PROVIDER=auto

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WEB_SEARCH_TOOL=web_search

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# A grounded research call + a synthesis call routinely takes 30–90s.
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# Hours a completed analysis stays authoritative before a re-run is suggested.
AI_CACHE_TTL_HOURS=168
# A `running` analysis older than this is presumed dead and swept to `failed`.
AI_RUN_STALE_MINUTES=15

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# AI calls cost money, so they get a tighter budget of their own.
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX=60

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
